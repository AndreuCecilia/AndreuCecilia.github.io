---
import Phd from "../components/icons/Phd.astro"
import Bbs from "../components/icons/Bbs.astro"
import Loading from "../components/icons/Loading.astro"
import Check from "../components/icons/Check.astro"

// Data is generated by the CAASE Lab harness (scripts/sync_personal.py).
// Edit the harness, not these JSON files.
import students from "../data/students.json";
const { currentPhdStudents, formerPhdStudents, bachelorStudents } = students;
---

<section id="students" class="w-full mx-auto pt-10 md:pt-14 scroll-m-10">
  <!-- PhD Students -->
  <h2 class="text-wrap hover:animate-pulse">
    <span class="flex items-center space-x-2 uppercase">
      <Phd />
      <span class="md:pl-0 lg:pl-4">Ph.D. Students</span>
    </span>
  </h2>

  <h3 class="pt-8 uppercase">
    <span class="flex items-center space-x-2">
      <Loading class="w-8 h-8 animate-spin" />
      <span>Current students</span>
    </span>
  </h3>
  <ul class="pt-4">
    {currentPhdStudents.map(student => (
      <li class="pt-3">
        <strong class="text-teal-600/90">{student.title}</strong>
        <p>
          <strong class="text-white">{student.years}</strong> - {student.name} - {student.program}
        </p>
      </li>
    ))}
  </ul>

  <h3 class="pt-10 uppercase">
    <span class="flex items-center space-x-2">
      <Check />
      <span>Former students</span>
    </span>
  </h3>
  <ul class="pt-4">
    {formerPhdStudents.map(student => (
      <li class="pt-3">
        <strong class="text-teal-600/90">
          {student.link ? <a href={student.link}>{student.title}</a> : student.title}
        </strong>
        <p>
          <strong class="text-white">{student.years}</strong> - {student.name} - {student.program}
        </p>
      </li>
    ))}
  </ul>

  <!-- Bachelor/M.Sc. Students -->
  <h2 id="msc-students" class="text-wrap pt-16 hover:animate-pulse">
    <span class="flex items-center space-x-2 uppercase">
      <Bbs />
      <span class="">Bachelor/M. Sc. Students</span>
    </span>
  </h2>

  <ul class="pt-8">
    {bachelorStudents.map(student => (
      <li class="pt-3">
        <strong class="text-teal-600/90 flex items-center space-x-2">
          
          {student.link ? <a href={student.link}>{student.title}</a> : student.title}
        </strong>
        <p>
          <strong class="text-white">{student.years}</strong> - {student.name} - {student.program}
        </p>
      </li>
    ))}
  </ul>
</section>
