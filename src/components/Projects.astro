---
import List from "../components/icons/List.astro"

// Data is generated by the CAASE Lab harness (scripts/sync_personal.py).
// Edit the harness, not these JSON files.
import projects from "../data/projects.json";
---

<section id="projects" class="w-full mx-auto pt-10 md:pt-14 scroll-m-10">
  <h2 class="text-wrap hover:animate-pulse">
    <span class="flex items-center space-x-2 uppercase ">
      <List />
      <span class="md:pl-0 lg:pl-4">Projects</span>
    </span>
  </h2>
  
  <ul class="">
    {projects.map((project) => (
      <li class=" text-teal-600/90">
        <p class="text-white/80">
          <strong class="text-teal-600/90 md:text-white">{project.name}</strong>
          {project.title && <span> — {project.title}</span>}.
          {project.funding && <span class="text-white/60"> {project.funding}.</span>}
          {" "}{project.role} <strong>{project.year}</strong>
        </p>
      </li>
    ))}
  </ul>
</section>
